# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.uv-cache/

# Rust build output
target/
# Ignore generated distribution contents except Windows executables. Keeping
# directories visible allows Git to reach and track an executable nested in a
# versioned package folder without also adding ZIPs, documentation, or keywords.
dist/**
!dist/**/
!dist/**/*.exe

# Generated transcripts and logs
transcripts/
*-audio/
*.log

# Local secrets and environment files
.env
.env.*
!.env.example

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
